FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore Rovio.MatchMaking.Net/Rovio.MatchMaking.Net.csproj
RUN dotnet publish Rovio.MatchMaking.Net/Rovio.MatchMaking.Net.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Rovio.MatchMaking.Net.dll"]
